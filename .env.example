APP_NAME="Believe App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Vite dev server hostname. Defaults to APP_URL host, then bapp.test, then 127.0.0.1.
# Set this if `npm run dev` fails with ENOTFOUND or mixed-content on your local domain.
# VITE_DEV_SERVER_HOST=believeinunity.test

# Linked from dev login landing (501c3ers.com only)
PRODUCTION_APP_URL=https://believeinunity.org
DEVELOPMENT_HOSTS=501c3ers.com,www.501c3ers.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Sentry error monitoring (set DSN on servers; leave empty locally)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Local DB — the docker one-liner in CLAUDE.md gives you exactly these creds on 33066.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33066
DB_DATABASE=believe
DB_USERNAME=believe
DB_PASSWORD=believe
# MySQL strict mode (enable on staging first; keep false on production until tested)
DB_STRICT=false

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=43200

# On the shared VPS, each site MUST set a unique Redis prefix (queues + cache + sessions).
# Same APP_NAME without REDIS_PREFIX causes workers to steal each other's jobs.
# REDIS_PREFIX=believeinunity_
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Streaming pipeline (Laravel ↔ AWS SQS/Fargate/MediaMTX ↔ YouTube)
# ----------------------------------------------------------------------------
# Two modes:
#
#   (A) Simulate mode — DEFAULT for local dev. No AWS, no SQS, no tunnel.
#       Laravel applies "starting → live" in-process when a stream is queued,
#       so the UI works end-to-end without external services. Use this if you
#       are just developing the app and don't want to touch real infra.
#
#   (B) Real pipeline — flip STREAMING_SIMULATE_WORKER=false and fill in the
#       AWS block + LARAVEL_CALLBACK_TOKEN + STREAMING_CALLBACK_BASE_URL.
#       In production this is automatic. For local end-to-end testing against
#       the real AWS worker you also need a public callback URL (the AWS
#       worker has to reach your Laravel) — a cloudflared quick-tunnel is the
#       usual trick:  cloudflared tunnel --url http://localhost:8001
#       then paste the trycloudflare.com URL into STREAMING_CALLBACK_BASE_URL.
STREAMING_SIMULATE_WORKER=true

# AWS — Laravel producer IAM user (sqs:SendMessage only on the streaming queue).
# Leave blank in simulate mode.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_STREAMING_QUEUE_URL=

# Shared bearer token the AWS worker uses when POSTing /api/streaming/status.
# Must match the value stored in the worker's Secrets Manager entry. Leave
# blank in simulate mode.
LARAVEL_CALLBACK_TOKEN=

# MediaMTX bridge — browser publishes WHIP here; worker pulls RTMP from the
# same host. These two are the public bridge hostname and port — they don't
# need to be reachable from your laptop in simulate mode, so leaving the
# defaults in is fine.
STREAMING_BRIDGE_HOST=stream.believeinunity.org
# WHIP/WHEP port for VDO.Ninja &mediamtx and canvas mixer (default 8889)
# STREAMING_BRIDGE_WHIP_PORT=8889
# false = never add &mediamtx to VDO URLs (stops "WHIP out failed" on prod until bridge is ready)
# STREAMING_BRIDGE_BROWSER_PUSH_ENABLED=true
# Set true only if local dev must WHIP-push to the remote bridge (ignored when BROWSER_PUSH_ENABLED=false)
# STREAMING_BRIDGE_PUSH_ON_LOCAL=false
STREAMING_WORKER_RTMP_PULL_BASE=rtmp://stream.believeinunity.org:1935

# Public callback base for the AWS worker to POST status back to Laravel.
# In production: set to your public Laravel domain (e.g. https://believeinunity.org).
# For local end-to-end testing against real AWS: paste a cloudflared quick-tunnel URL.
# In simulate mode: leave blank — Laravel uses APP_URL.
STREAMING_CALLBACK_BASE_URL=

# ECS Fargate worker monitoring (DescribeTasks / StopTask on End Stream).
# Worker should POST task_arn (or ecs_task_arn) on status callbacks once the task starts.
# IAM user also needs ecs:DescribeTasks + ecs:StopTask on the cluster (not only sqs:SendMessage).
STREAMING_ECS_MONITOR_ENABLED=true
STREAMING_ECS_CLUSTER=biu-stream-prod-cluster
# STREAMING_ECS_REGION=us-east-1
# Preparing Stream timeout (seconds) — fail + cleanup if still starting
STREAMING_STARTING_TIMEOUT_SECONDS=120

# Scout — disable while no Algolia/Meilisearch configured
SCOUT_DRIVER=null

# Unity Call — outbound audio from chat (1:1). Default: enabled on all environments.
UNITY_CALL_ENABLED=true

# Reverb — https://laravel.com/docs/13.x/reverb
# Server process (reverb:start / Supervisor) — plain WS on loopback:
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
# Local ForgeStack (HTTPS site on 443): proxy /app and /apps to 127.0.0.1:8080 — see forgestack/README.md
# REVERB_HOST=believeinunity.test
# REVERB_PORT=443
# REVERB_SCHEME=https
# REVERB_BROADCAST_HOST=127.0.0.1
# REVERB_BROADCAST_PORT=8080
# REVERB_BROADCAST_SCHEME=http
# If PHP must call https://your-site.test instead: REVERB_VERIFY_SSL=false (local only)
# REVERB_VERIFY_SSL=true
# Default below = direct ws to Reverb without nginx (no mixed-content on HTTPS pages):
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Browser / broadcast client options (wss via nginx: public host + port 443):
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Comma-separated hostnames (not full URLs). Use * to allow all. Local APP_ENV=local allows * automatically.
# REVERB_ALLOWED_ORIGINS=501c3ers.com,www.501c3ers.com,merchant.501c3ers.com
REVERB_ALLOWED_ORIGINS=

# Stripe — leave blank to disable
STRIPE_KEY=
STRIPE_SECRET=
CASHIER_CURRENCY=usd

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Twilio SSL / account mode only (SID, token, From are admin Settings → Twilio — database only)
TWILIO_VERIFY_SSL=true
TWILIO_CAFILE=
TWILIO_ACCOUNT_MODE=auto

# APP_URL must be correct so WhatsApp/SMS "Check Notifications" links are absolute
# APP_URL=https://believeinunity.org

# Google (YouTube OAuth, GCal, etc.)
# OAuth scopes include youtube.upload for publishing Dropbox recordings to YouTube.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube OAuth (defaults to GOOGLE_* above; redirect = APP_URL/integrations/youtube/callback)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Facebook Page connection (NOT platform login — users auth with our app first)
# Redirect URI must exactly match Meta App Dashboard → Facebook Login → Valid OAuth Redirect URIs
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/facebook/callback"
FACEBOOK_API_VERSION=v21.0
FACEBOOK_DATA_DELETION_URL="${APP_URL}/data-deletion"
# Optional: Facebook Login for Business configuration ID (Meta App Dashboard)
# FACEBOOK_CONFIG_ID=
# TEMPORARY verbose OAuth logging (tokens, scopes, /me/accounts). Disable after debugging.
FACEBOOK_OAUTH_DEBUG=true

# FCM (push notifications)
FCM_PROJECT_ID=
FCM_CREDENTIALS=
# Push jobs use sync by default so alerts work without queue:work. Set database only if a worker handles push.
# PUSH_QUEUE_CONNECTION=sync

# Bridge (wallet KYC/KYB)
# BRIDGE_API_KEY=
# BRIDGE_ENVIRONMENT=sandbox

# Cloudflare Turnstile (bot protection on public/auth forms)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Legacy alias also accepted:
# TURNSTILE_SECRET=

# WebRTC TURN — self-hosted coturn on Hostinger VPS (72.60.226.88)
WEBRTC_TURN_PUBLIC_IP=72.60.226.88
WEBRTC_TURN_URL=turn:72.60.226.88:3478,turn:501c3ers.com:3478,turns:501c3ers.com:5349?transport=tcp
WEBRTC_TURN_USERNAME=believe501c3
WEBRTC_TURN_CREDENTIAL=
WEBRTC_USE_THIRD_PARTY_TURN=false
# Leave empty to disable Metered third-party TURN:
# WEBRTC_TURN_API_KEY=
# BRIDGE_BASE_URL=https://api.sandbox.bridge.xyz/v0
# BRIDGE_REDIRECT_URI=
# Local Windows only — if cURL error 60 (SSL CA bundle missing). Never set false in production.
# BRIDGE_VERIFY_SSL=false
